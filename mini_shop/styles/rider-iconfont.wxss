/* 图标字体（iconfont 项目 5230143）
 * 来源：Font class CDN //at.alicdn.com/t/c/font_5230143_imyahvlrzjd.css（2026-10-09 下载）
 * ⚠️ 小程序 wxss 不能引用远程字体（指向 at.alicdn.com 的 url 在真机无效），故把 ttf 转 base64 内联（8.3 KB → 11.1 KB）。
 * ⚠️ 本文件是 mini_shop **唯一**的字体内联点（整仓只有这一处 font-face 声明）：
 *    字体只内联一次 —— 两份声明会把同一段 base64 原样重复打进包，纯浪费体积。
 * 用法：<text class="rider-icon rider-icon-dianhua" />   ← 骑手端 / 既有用法（保留兼容，勿删）
 *       <text class="app-icon app-icon-daifukuan" />     ← C 端新增字形（个人中心「我的订单」入口）
 * ⚠️ 2026-10-09 换字体：旧 ttf（19 字形，码位 e897–e8a9）整体替换为新版 ttf（32 字形，**严格超集**）：
 *    19 个旧码位一字未变，新增 e600 / e603 / e604 / e605 / e606（本次用到）与 e8aa–e8b1。
 *    ⇒ 既有 rider-icon-* 用法**字形与码位完全不变**，调用方无需任何改动。
 */
@font-face {
  font-family: "rider-iconfont";
  src: url("data:font/truetype;charset=utf-8;base64,");
}

/* 骑手端 / 既有字形（2026-10-09 起与 C 端 app-icon-* 共用同一个字体文件；以下 19 条规则原样保留）。 */
.rider-icon {
  font-family: "rider-iconfont" !important;
  font-style: normal;
  line-height: 1;
  -webkit-font-smoothing: antialiased;
}

.rider-icon-peisongzhong::before { content: "\e8a5"; }

.rider-icon-jiantou_shang::before { content: "\e8a6"; }

.rider-icon-fuzhi::before { content: "\e8a7"; }

.rider-icon-gouxuan_tianchong::before { content: "\e8a8"; }

.rider-icon-daohang::before { content: "\e8a9"; }

.rider-icon-weizhi1::before { content: "\e89f"; }

.rider-icon-jiantou_xia::before { content: "\e8a0"; }

.rider-icon-tianjia::before { content: "\e8a1"; }

.rider-icon-jingbao::before { content: "\e8a2"; }

.rider-icon-shijian::before { content: "\e8a3"; }

.rider-icon-dianhua::before { content: "\e8a4"; }

.rider-icon-guanbi_tianchong::before { content: "\e89e"; }

.rider-icon-jinhuayouli::before { content: "\e89d"; }

.rider-icon-weizhi::before { content: "\e897"; }

.rider-icon-fenxiang::before { content: "\e898"; }

.rider-icon-buju_zuoyou::before { content: "\e899"; }

.rider-icon-caidan_zhankai::before { content: "\e89a"; }

.rider-icon-sousuo::before { content: "\e89b"; }

.rider-icon-buju_shangxia::before { content: "\e89c"; }

/* ---- C 端图标（2026-10-09 新增）----
 * ⚠️ 只加**实际用到**的字形（个人中心「我的订单」的 5 个入口），不照搬 iconfont 整套 font class 列表。
 * 每条规则后的注释是 iconfont 原始类名 —— 换字体时照此核对码位，别凭记忆改。 */
.app-icon {
  font-family: "rider-iconfont" !important;
  font-style: normal;
  line-height: 1;
  -webkit-font-smoothing: antialiased;
}

.app-icon-daifukuan::before { content: "\e600"; }  /* icon-a-31daifukuan  待付款 */

.app-icon-daishouhuo::before { content: "\e606"; }  /* icon-a-31daishouhuo  待收货 */

